generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  subdomain             String                 @unique
  status                String                 @default("active")
  contactEmail          String?
  contactPhone          String?
  logoUrl               String?
  theme                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  academicYears         AcademicYear[]
  announcements         Announcement[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  auditLogs             AuditLog[]
  cbcStrands            CbcStrand[]
  cbcSubStrands         CbcSubStrand[]
  classes               SchoolClass[]
  departments           Department[]
  courseModules         CourseModule[]
  examBlueprints        ExamBlueprint[]
  examPapers            ExamPaper[]
  examPaperQuestions    ExamPaperQuestion[]
  feeStructures         FeeStructure[]
  groups                Group[]
  guardians             Guardian[]
  inventoryItems        InventoryItem[]
  invoicesTenant        Invoice[]
  courses               LMSCourse[]
  lmsProgress           LMSCourseProgress[]
  lessons               Lesson[]
  lessonMaterials       LessonMaterial[]
  libraryBooks          LibraryBook[]
  loginLogs             LoginLog[]
  payments              Payment[]
  invoices              PlatformInvoice[]
  questionBank          QuestionBankItem[]
  quizzes               Quiz[]
  quizAttempts          QuizAttempt[]
  quizQuestions         QuizQuestion[]
  receipts              Receipt[]
  reportCardLines       ReportCardLine[]
  reportCards           ReportCards[]
  roles                 Role[]
  settings              SchoolSetting?
  staffAttendance       StaffAttendance[]
  staff                 StaffProfile[]
  students              Student[]
  studentAttendance     StudentAttendance[]
  studentExamScores     StudentExamScore[]
  subjects              Subject[]
  supportTickets        SupportTicket[]
  domains               TenantDomain[]
  loginAsTokens         TenantLoginAsToken[]
  subscription          TenantSubscription?
  transportRoutes       TransportRoute[]
  users                 User[]
}

model Plan {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String?
  priceMonthly  Decimal              @default(0)
  billingCycle  String               @default("monthly")
  maxStudents   Int                  @default(500)
  moduleToggles Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  planId             String
  status             String    @default("trial")
  trialStart         DateTime  @default(now())
  trialEnd           DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plan               Plan      @relation(fields: [planId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
}

model OwnerUser {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String?
  passwordHash String
  status       String             @default("active")
  isActive     Boolean            @default(true)
  lastLogin    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  roles        OwnerUserRole[]
  auditLogs    PlatformAuditLog[]
}

model OwnerRole {
  id          String                @id @default(uuid())
  name        String                @unique
  permissions OwnerRolePermission[]
  users       OwnerUserRole[]
}

model OwnerPermission {
  id    String                @id @default(uuid())
  key   String                @unique
  roles OwnerRolePermission[]
}

model OwnerRolePermission {
  roleId       String
  permissionId String
  permission   OwnerPermission @relation(fields: [permissionId], references: [id])
  role         OwnerRole       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model OwnerUserRole {
  userId String
  roleId String
  role   OwnerRole @relation(fields: [roleId], references: [id])
  user   OwnerUser @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model TenantLoginAsToken {
  id          String   @id @default(uuid())
  tenantId    String
  ownerUserId String
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model PlatformAuditLog {
  id          String     @id @default(uuid())
  ownerUserId String?
  action      String
  entityType  String?
  entityId    String?
  metaJson    Json?
  createdAt   DateTime   @default(now())
  ownerUser   OwnerUser? @relation(fields: [ownerUserId], references: [id])
}

model SupportTicket {
  id              String   @id @default(uuid())
  tenantId        String
  createdByUserId String
  status          String   @default("open")
  subject         String
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

model TenantDomain {
  id        String   @id @default(uuid())
  domain    String   @unique
  tenantId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model PlatformInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  amount    Decimal
  status    String   @default("pending")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model User {
  id               String        @id @default(uuid())
  tenantId         String
  email            String?
  phone            String?
  firstName        String?
  lastName         String?
  passwordHash     String
  status           String        @default("active")
  isActive         Boolean       @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  auditLogs        AuditLog[]
  loginLogs        LoginLog[]
  messagesSent     Message[]     @relation("SentMessages")
  messagesReceived Message[]     @relation("ReceivedMessages")
  staffProfile     StaffProfile?
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  roles            UserRole[]
  sessions         UserSession[]

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key])
  role          Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionKey])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceInfo       Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id])
}

model LoginLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SchoolSetting {
  tenantId     String   @id
  jsonSettings Json
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  terms     Term[]
}

model Term {
  id             String          @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean         @default(false)
  examBlueprints ExamBlueprint[]
  feeStructures  FeeStructure[]
  invoices       Invoice[]
  reportCards    ReportCards[]
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
}

model SchoolClass {
  id                String             @id @default(uuid())
  tenantId          String
  levelType         String
  levelName         String
  streamName        String
  capacity          Int
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  examBlueprints    ExamBlueprint[]
  feeStructures     FeeStructure[]
  courses           LMSCourse[]
  questionBankItems QuestionBankItem[]
  reportCards       ReportCards[]
  classTeacherId    String?
  classTeacher      StaffProfile?      @relation(fields: [classTeacherId], references: [id])
  students          Student[]
}

model Subject {
  id                String             @id @default(uuid())
  tenantId          String
  levelType         String
  levelName         String
  name              String
  code              String?
  strands           CbcStrand[]
  courses           LMSCourse[]
  questionBankItems QuestionBankItem[]
  reportCardLines   ReportCardLine[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, levelType, levelName, name])
}

model CbcStrand {
  id                String             @id @default(uuid())
  tenantId          String
  subjectId         String
  name              String
  subject           Subject            @relation(fields: [subjectId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  subStrands        CbcSubStrand[]
  questionBankItems QuestionBankItem[]
}

model CbcSubStrand {
  id                String             @id @default(uuid())
  tenantId          String
  strandId          String
  name              String
  strand            CbcStrand          @relation(fields: [strandId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  questionBankItems QuestionBankItem[]
}

model Student {
  id                    String                 @id @default(uuid())
  tenantId              String
  admNo                 String
  firstName             String
  lastName              String
  gender                String?
  dob                   DateTime?
  classId               String
  status                String                 @default("active")
  guardianId            String?
  assignmentSubmissions AssignmentSubmission[]
  invoices              Invoice[]
  courseProgress        LMSCourseProgress[]
  quizAttempts          QuizAttempt[]
  reportCards           ReportCards[]
  class                 SchoolClass            @relation(fields: [classId], references: [id])
  guardian              Guardian?              @relation(fields: [guardianId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  attendance            StudentAttendance[]
  examScores            StudentExamScore[]

  @@unique([tenantId, admNo])
}

model Guardian {
  id       String    @id @default(uuid())
  tenantId String
  fullName String
  phone    String?
  email    String?
  relation String?
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  students Student[]
}

model StaffProfile {
  id             String            @id @default(uuid())
  tenantId       String
  userId         String            @unique
  staffNo        String
  title          String?
  designation    String?
  isTeachingStaff Boolean          @default(true)
  employmentType String?
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id])
  attendance     StaffAttendance[]
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  classesTaught  SchoolClass[]

  @@unique([tenantId, staffNo])
}

model Department {
  id        String         @id @default(uuid())
  tenantId  String
  name      String
  staff     StaffProfile[]
  tenant    Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model StudentAttendance {
  id             String   @id @default(uuid())
  tenantId       String
  date           DateTime
  classId        String
  studentId      String
  status         String
  markedByUserId String
  student        Student  @relation(fields: [studentId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
}

model StaffAttendance {
  id             String       @id @default(uuid())
  tenantId       String
  date           DateTime
  staffUserId    String
  status         String
  markedByUserId String
  staffUser      StaffProfile @relation(fields: [staffUserId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
}

model ExamBlueprint {
  id              String      @id @default(uuid())
  tenantId        String
  name            String
  termId          String
  classId         String
  subjectId       String?
  totalMarks      Int
  durationMinutes Int
  rulesJson       Json?
  status          String      @default("draft")
  class                 SchoolClass       @relation(fields: [classId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  term            Term        @relation(fields: [termId], references: [id])
  papers          ExamPaper[]
}

model QuestionBankItem {
  id           String              @id @default(uuid())
  tenantId     String
  subjectId    String
  classId      String
  strandId     String?
  subStrandId  String?
  topic        String?
  difficulty   String              @default("medium")
  bloomLevel   String              @default("understand")
  type         String              @default("structured")
  marks        Int                 @default(1)
  questionText String
  optionsJson  Json?
  answerJson   Json?
  status       String              @default("draft")
  createdBy    String
  reviewedBy   String?
  approvedBy   String?
  createdAt    DateTime            @default(now())
  examPaperQs  ExamPaperQuestion[]
  class                 SchoolClass               @relation(fields: [classId], references: [id])
  strand       CbcStrand?          @relation(fields: [strandId], references: [id])
  subStrand    CbcSubStrand?       @relation(fields: [subStrandId], references: [id])
  subject      Subject             @relation(fields: [subjectId], references: [id])
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
}

model ExamPaper {
  id            String              @id @default(uuid())
  tenantId      String
  blueprintId   String
  versionLabel  String
  title         String
  status        String              @default("draft")
  generatedBy   String
  approvedBy    String?
  publishedAt   DateTime?
  blueprint     ExamBlueprint       @relation(fields: [blueprintId], references: [id])
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  questions     ExamPaperQuestion[]
  studentScores StudentExamScore[]
}

model ExamPaperQuestion {
  id            String           @id @default(uuid())
  tenantId      String
  examPaperId   String
  questionId    String
  questionOrder Int
  marksOverride Int?
  sectionLabel  String?
  examPaper     ExamPaper        @relation(fields: [examPaperId], references: [id])
  question      QuestionBankItem @relation(fields: [questionId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
}

model StudentExamScore {
  id          String    @id @default(uuid())
  tenantId    String
  examPaperId String
  studentId   String
  score       Decimal
  gradedBy    String
  createdAt   DateTime  @default(now())
  examPaper   ExamPaper @relation(fields: [examPaperId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model ReportCards {
  id          String           @id @default(uuid())
  tenantId    String
  termId      String
  classId     String
  studentId   String
  status      String           @default("draft")
  generatedAt DateTime?        @default(now())
  lines       ReportCardLine[]
  class                 SchoolClass            @relation(fields: [classId], references: [id])
  student     Student          @relation(fields: [studentId], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  term        Term             @relation(fields: [termId], references: [id])
}

model ReportCardLine {
  id           String      @id @default(uuid())
  tenantId     String
  reportCardId String
  subjectId    String
  score        Decimal?
  grade        String?
  remarks      String?
  reportCard   ReportCards @relation(fields: [reportCardId], references: [id])
  subject      Subject     @relation(fields: [subjectId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
}

model LMSCourse {
  id          String              @id @default(uuid())
  tenantId    String
  title       String
  subjectId   String
  classId     String
  description String?
  status      String              @default("draft")
  createdBy   String
  publishedAt DateTime?
  assignments Assignment[]
  modules     CourseModule[]
  class                 SchoolClass               @relation(fields: [classId], references: [id])
  subject     Subject             @relation(fields: [subjectId], references: [id])
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  progress    LMSCourseProgress[]
  quizzes     Quiz[]
}

model CourseModule {
  id       String    @id @default(uuid())
  tenantId String
  courseId String
  title    String
  orderNo  Int
  course   LMSCourse @relation(fields: [courseId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  lessons  Lesson[]
}

model Lesson {
  id          String           @id @default(uuid())
  tenantId    String
  moduleId    String
  title       String
  contentHtml String?
  orderNo     Int
  status      String           @default("draft")
  module      CourseModule     @relation(fields: [moduleId], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  materials   LessonMaterial[]
}

model LessonMaterial {
  id       String  @id @default(uuid())
  tenantId String
  lessonId String
  fileUrl  String
  fileType String?
  title    String
  lesson   Lesson  @relation(fields: [lessonId], references: [id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
}

model Assignment {
  id           String                 @id @default(uuid())
  tenantId     String
  courseId     String
  title        String
  instructions String?
  dueAt        DateTime?
  totalMarks   Int
  status       String                 @default("draft")
  course       LMSCourse              @relation(fields: [courseId], references: [id])
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  tenantId     String
  assignmentId String
  studentId    String
  fileUrl      String?
  textAnswer   String?
  submittedAt  DateTime   @default(now())
  score        Decimal?
  gradedBy     String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
}

model Quiz {
  id              String         @id @default(uuid())
  tenantId        String
  courseId        String
  title           String
  durationMinutes Int
  totalMarks      Int
  status          String         @default("draft")
  course          LMSCourse      @relation(fields: [courseId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  attempts        QuizAttempt[]
  questions       QuizQuestion[]
}

model QuizQuestion {
  id           String @id @default(uuid())
  tenantId     String
  quizId       String
  questionText String
  type         String
  optionsJson  Json?
  answerJson   Json?
  marks        Int    @default(1)
  orderNo      Int
  quiz         Quiz   @relation(fields: [quizId], references: [id])
  tenant       Tenant @relation(fields: [tenantId], references: [id])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  tenantId    String
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Decimal?
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model LMSCourseProgress {
  id        String    @id @default(uuid())
  tenantId  String
  courseId  String
  studentId String
  progress  Decimal   @default(0)
  course    LMSCourse @relation(fields: [courseId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([studentId, courseId])
}

model FeeStructure {
  id            String  @id @default(uuid())
  tenantId      String
  classId       String
  termId        String
  totalAmount   Decimal
  voteheadsJson Json?
  class                 SchoolClass   @relation(fields: [classId], references: [id])
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  term          Term    @relation(fields: [termId], references: [id])
}

model Invoice {
  id        String    @id @default(uuid())
  tenantId  String
  studentId String
  termId    String
  invoiceNo String
  amount    Decimal
  status    String    @default("unpaid")
  createdAt DateTime  @default(now())
  student   Student   @relation(fields: [studentId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  term      Term      @relation(fields: [termId], references: [id])
  payments  Payment[]

  @@unique([tenantId, invoiceNo])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String
  method     String
  amount     Decimal
  reference  String?
  receivedBy String
  receivedAt DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  receipt    Receipt?
}

model Receipt {
  id        String   @id @default(uuid())
  tenantId  String
  paymentId String   @unique
  receiptNo String
  pdfUrl    String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, receiptNo])
}

model Announcement {
  id         String   @id @default(uuid())
  tenantId   String
  title      String
  message    String
  targetJson Json?
  status     String   @default("draft")
  createdBy  String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  tenantId   String
  fromUserId String
  toUserId   String?
  groupId    String?
  text       String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id])
  group      Group?   @relation(fields: [groupId], references: [id])
  toUser     User?    @relation("ReceivedMessages", fields: [toUserId], references: [id])
}

model Group {
  id       String    @id @default(uuid())
  tenantId String
  name     String
  type     String
  metaJson Json?
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [actorUserId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model LibraryBook {
  id        String  @id @default(uuid())
  tenantId  String
  title     String
  author    String?
  isbn      String?
  quantity  Int     @default(1)
  available Int     @default(1)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
}

model TransportRoute {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  fee         Decimal @default(0)
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
}

model InventoryItem {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  category String?
  quantity Int     @default(0)
  unit     String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
}
