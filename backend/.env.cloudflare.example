# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare-for-SaaS custom domains
# Add these to your backend .env (or pm2 ecosystem env), then restart the API.
# The implementation uses Cloudflare's Custom Hostnames API, which auto-issues a
# free SSL certificate per customer domain (no per-record DNS management needed).
# ─────────────────────────────────────────────────────────────────────────────

# API token from https://dash.cloudflare.com/profile/api-tokens
# Required permissions on the SaaS zone (shulecloud.com):
#   Zone:Read, DNS:Edit, SSL and Certificates:Edit, Zone Settings:Read
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Zone ID of your SaaS root domain (Cloudflare → shulecloud.com → Overview → Zone ID)
CLOUDFLARE_ZONE_ID=your_zone_id

# Your SaaS root domain (used to reject attempts to "add" the platform domain).
SAAS_ROOT_DOMAIN=shulecloud.com

# The CNAME target every customer domain points at. For Cloudflare for SaaS this
# is your fallback-origin / SaaS hostname. Schools create:
#   CNAME  portal.theirschool.ac.ke  →  cname.shulecloud.com
CLOUDFLARE_SAAS_TARGET=cname.shulecloud.com
